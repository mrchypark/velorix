        { "change_id": "o-002", "relation": "orders", "op": "insert", "before": null, "after": { "order_id": "o2", "customer_id": "c1", "product_id": "p2", "amount": 40, "event_time": "2026-08-09T00:01:00Z" } },
        { "change_id": "o-003", "relation": "orders", "op": "insert", "before": null, "after": { "order_id": "o3", "customer_id": "c2", "product_id": "p1", "amount": 70, "event_time": "2026-08-09T00:02:00Z" } }
