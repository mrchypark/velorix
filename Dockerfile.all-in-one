# syntax=docker/dockerfile:1.7
FROM rust:1.98.0-bookworm@sha256:82150a52ec202c1b14d7817e14516c392bb7f5cfebd88f1ed531cb37ebd39922 AS builder

RUN rustup toolchain install 1.98.1 --profile minimal --no-self-update \
    && rustup default 1.98.1 \
    && rustc --version | grep -Eq '^rustc 1\.98\.1 '

RUN apt-get update \
    && apt-get install -y --no-install-recommends protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
COPY --from=velorix-hiqlite-source . /hiqlite
RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,target=/usr/local/cargo/git,sharing=locked \
    --mount=type=cache,target=/workspace/target,sharing=locked \
    RUSTFLAGS="-C strip=symbols" cargo build --release -p velorix-api -p velorix-ingest-writer --locked \
    && RUSTFLAGS="-C strip=symbols" cargo build --release -p velorix-meta --features hiqlite-backend --locked \
    && cp /workspace/target/release/velorix-api /workspace/velorix-api \
    && cp /workspace/target/release/velorix-meta /workspace/velorix-meta \
    && cp /workspace/target/release/velorix-ingest-writer /workspace/velorix-ingest-writer

FROM debian:bookworm-slim@sha256:0104b334637a5f19aa9c983a91b54c89887c0984081f2068983107a6f6c21eeb AS runtime

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /workspace/velorix-api /usr/local/bin/velorix-api
COPY --from=builder /workspace/velorix-meta /usr/local/bin/velorix-meta
COPY --from=builder /workspace/velorix-ingest-writer /usr/local/bin/velorix-ingest-writer
COPY scripts/velorix-ingest-writer-entrypoint.sh /usr/local/bin/velorix-ingest-writer-entrypoint
COPY scripts/velorix-all-in-one-entrypoint.sh /usr/local/bin/velorix-all-in-one-entrypoint
RUN chmod 0755 /usr/local/bin/velorix-ingest-writer-entrypoint \
    /usr/local/bin/velorix-all-in-one-entrypoint

USER 65532:65532
EXPOSE 8080 8443 9090
ENTRYPOINT ["/usr/local/bin/velorix-all-in-one-entrypoint"]
